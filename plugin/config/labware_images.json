      "photo": "microtubes",
      "name": "1.5 / 2 mL microcentrifuge tube"
    },
    {
      "match": "falcon|15mL|50mL|14mL|centrifuge_tube",
      "kind": "container",
      "photo": "conical_tubes",
      "name": "Conical centrifuge tube"
    },
    {
      "match": ".",
      "kind": "container",
      "photo": "star_deck",
      "name": "Container"
    },
    {
      "match": ".",
      "kind": "trash",
      "photo": "star_deck",
      "name": "The deck's tip waste"
    }
  ]
